<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo = color (values/ic_launcher_background.xml; values-night/ lo cambia en modo oscuro). El emblema es
         blanco sobre transparente, así que SOLO el color de fondo cambia entre claro y oscuro. -->
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </foreground>
    <!-- Android 13+: ícono "con tema" (se tiñe con el color del fondo de pantalla del usuario) -->
    <monochrome>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </monochrome>
</adaptive-icon>