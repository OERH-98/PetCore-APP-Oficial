<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Canal por defecto de los push de FCM (Android 8+): el que crea la app al arrancar con importancia alta
             (push_fcm_utils.js, mismo id). Cubre los mensajes que lleguen sin channelId. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="petcore_alertas" />
        <!-- Ícono pequeño de la barra de estado: Android pide una silueta BLANCA con transparencia (sin color); si no
             se declara usa el ícono del launcher, que a color se ve como un cuadro gris. Los PNG están en
             res/drawable-{mdpi..xxxhdpi}/ic_stat_petcore.png (24/36/48/72/96 px). Android siempre dibuja ese
             ícono en monocromo (blanco/gris) en la barra de estado; el COLOR solo se aplica al desplegar la
             notificación (ícono pequeño + nombre de la app). Es azul en tema claro y un azul más claro en tema
             oscuro (res/values/colors.xml y res/values-night/colors.xml: notificacion_color). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_petcore" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificacion_color" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Guardar PDF en Documentos (Android 9 o menor; en 10+ no hace falta) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
</manifest>
