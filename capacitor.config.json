{
  "appId": "com.petcore.app.oficial",
  "appName": "PetCore",
  "webDir": "dist",
  "server": {
    "iosScheme": "https"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK"
    }
  },
  "ios": {
    "plugins": {
      "CapacitorHttp": {
        "enabled": true
      },
      "CapacitorCookies": {
        "enabled": true
      }
    }
  }
}
