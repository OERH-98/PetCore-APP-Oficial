{
  "appId": "com.petcore.app.oficial",
  "appName": "PetCore",
  "webDir": "dist",
  "server": {
    "iosScheme": "https"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#2D60A1",
      "style": "DARK"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    }
  }
}
